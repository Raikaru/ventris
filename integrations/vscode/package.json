{
  "name": "ventris-binary-analysis",
  "displayName": "Ventris Binary Analysis",
  "description": "Inspect, lift, and decompile native functions with Ventris.",
  "version": "0.2.0",
  "publisher": "ventris",
  "license": "Apache-2.0",
  "preview": true,
  "keywords": ["binary analysis", "disassembler", "decompiler", "reverse engineering"],
  "scripts": {
    "package": "node package.js",
    "acceptance": "node acceptance/run.js"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:ventris.inspect",
    "onCommand:ventris.lift",
    "onCommand:ventris.decompile"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "ventris.inspect", "title": "Ventris: Inspect Binary" },
      { "command": "ventris.lift", "title": "Ventris: Lift Function" },
      { "command": "ventris.decompile", "title": "Ventris: Decompile Function" }
    ],
    "configuration": {
      "title": "Ventris",
      "properties": {
        "ventris.binary": {
          "type": "string",
          "default": "ventris",
          "description": "Path to the Ventris executable."
        },
        "ventris.target": {
          "type": "string",
          "enum": ["", "atari2600", "nes", "snes", "master-system", "game-gear", "genesis", "neo-geo", "c64", "ps1", "ps2", "n64", "saturn", "dreamcast", "gamecube", "wii", "gba", "nds", "3ds", "psp", "vita", "wiiu", "xbox360", "ps3-ppu", "ps3-spu"],
          "default": "",
          "description": "Optional console target profile supplying architecture, loader, and ABI defaults."
        },
        "ventris.loader": {
          "type": "string",
          "enum": ["auto", "raw", "elf", "pe", "macho", "coff", "ihex", "srec", "n64-rom", "dol", "nds", "ncch", "psp-prx", "vita-self", "wiiu-rpl", "xex", "ps3-self"],
          "default": "auto",
          "description": "Image loader used by the function pipeline."
        },
        "ventris.base": {
          "type": "string",
          "default": "",
          "description": "Optional virtual base for raw or text image loaders."
        },
        "ventris.slice": {
          "type": "string",
          "default": "",
          "description": "Optional zero-based universal Mach-O slice index."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^11.8.0"
  },
  "overrides": {
    "diff": "9.0.0",
    "serialize-javascript": "7.1.0"
  }
}
